# --- LLM (Bedrock) ---
AWS_BEARER_TOKEN_BEDROCK=sua-apikey-do-bedrock
AWS_REGION=us-east-1

# --- GitHub App (para o comando local `review` e para o serviço) ---
GH_APP_ID=123456
GH_APP_INSTALLATION_ID=12345678
# Conteúdo PEM da chave privada do App (entre aspas, quebras de linha preservadas)
GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# --- Só o serviço (rotas /webhook /process /chunk) precisa das abaixo ---
# Em produção elas vêm do Terraform/Secret Manager, não de .env.
GITHUB_WEBHOOK_SECRET=segredo-compartilhado-com-o-github
PUBSUB_TOPIC=projects/SEU_PROJETO/topics/pr-review-requests
CHUNK_QUEUE=projects/SEU_PROJETO/locations/REGIAO/queues/pr-review-chunks
CHUNK_URL=https://SEU-SERVICO.run.app/chunk
OIDC_SA=sua-sa@SEU_PROJETO.iam.gserviceaccount.com
PROCESS_AUDIENCE=https://SEU-SERVICO.run.app
GH_BOT_LOGIN=seu-app[bot]
